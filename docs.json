{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Aflux",
  "colors": {
    "primary": "#72C4FF",
    "light": "#97FFB3",
    "dark": "#5BC8FF"
  },
  "fonts": {
    "heading": {
      "family": "Onest",
      "weight": 600
    },
    "body": {
      "family": "Onest",
      "weight": 400
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@aflux.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open console",
      "href": "https://console.aflux.ai"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python"
      ]
    },
    "mdx": {
      "server": "https://backend.aflux.ai",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Build a campaign",
            "pages": [
              "guides/projects",
              "guides/ad-copy",
              "guides/finding-channels",
              "guides/campaigns",
              "guides/media"
            ]
          },
          {
            "group": "Run a campaign",
            "pages": [
              "guides/placements",
              "guides/analytics"
            ]
          },
          {
            "group": "Billing",
            "pages": [
              "billing/balance",
              "billing/deposits",
              "billing/promo-codes"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "account/authentication",
              "account/api-keys"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/errors"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "https://backend.aflux.ai/openapi"
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "MCP server",
            "pages": [
              "mcp/overview",
              "mcp/tools",
              "mcp/protocol"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/aflux_ai"
    }
  }
}
