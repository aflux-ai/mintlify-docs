  "keyFeatures": [
    "Bulk email campaigns with contact segmentation, scheduling, and delivery analytics",
    "Legally-binding electronic signatures with multi-party workflows and audit trail",
    "Smart QR code generation with lifecycle control, custom design, and scan analytics",
    "Bring-your-own cloud storage (Google Drive, OneDrive, Dropbox) — no vendor lock-in",
    "Unified dashboard for document activity, email performance, and signature tracking",
    "Team management with roles, permissions, and per-module access control",
    "GDPR-compliant, EU-based platform with end-to-end encryption",
    "API access and webhooks for Business and Enterprise plans"
  ],
  "publicApiSurface": [
    "POST /api/signatures — create a signature request",
    "GET /api/signatures/{id} — retrieve signature status",
    "POST /api/emails/campaigns — create and send a bulk email campaign",
    "GET /api/emails/campaigns/{id}/analytics — retrieve campaign analytics",
    "POST /api/qr-codes — generate a QR code",
    "GET /api/qr-codes/{id}/scans — retrieve scan analytics",
    "Webhooks: signature.completed, signature.declined, email.delivered, email.bounced, qr.scanned"
  ]
}
